[Unit]
Description=Private food post Telegram bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=eat-bot
Group=eat-bot
WorkingDirectory=/opt/eat-bot
ExecStart=/opt/eat-bot/.venv/bin/python -u /opt/eat-bot/bot.py
Restart=on-failure
RestartSec=15
UMask=0077
StateDirectory=eat-bot
StateDirectoryMode=0700
Environment=OMP_THREAD_LIMIT=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eat-bot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=256M
MemoryMax=384M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
